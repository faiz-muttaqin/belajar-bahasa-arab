{
	"name": "belajar-bahasa-arab",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": "26.x"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "bun run build && playwright test",
		"test": "vitest --run && bun run test:e2e",
		"browsers:install": "playwright install --only-shell chromium",
		"verify": "bun run check && bun run lint && bun run test"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"@vitest/browser-playwright": "4.1.12",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"playwright": "1.65.0",
		"prettier": "3.10.0",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vitest": "4.1.12",
		"vitest-browser-svelte": "2.2.1"
	}
}
